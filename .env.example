# Copy this file to .env and fill in the values before running docker compose up.

# --- Security ---
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256

# --- Database (matches the `db` service in docker-compose.yml) ---
DATABASE_URL=postgresql+asyncpg://sehati:sehati@db:5432/sehati

# --- Redis (matches the `redis` service in docker-compose.yml) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=sehati

# --- SMTP (required to boot — use Mailtrap/Mailhog or any test SMTP for local testing) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=changeme
SMTP_SENDER=noreply@example.com
SMTP_IS_SSL=false

# --- Media ---
MEDIA_ROOT=/var/sehati-media
MEDIA_URL=/media
MAX_AVATAR_MB=2

# --- Firebase Cloud Messaging ---
# Service account JSON lives on the host at ./account/firebase-service-account.json
# and is mounted read-only into the container at this path — see docker-compose.yml.
FIREBASE_CREDENTIALS_PATH=account/firebase-service-account.json
