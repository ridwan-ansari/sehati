# Copy this file to .env and fill in the values before running docker compose up.

# --- Security ---
# generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-string
ALGORITHM=HS256

# --- Database (drives both the `db` service init and the app's connection string —
# keep POSTGRES_PASSWORD and the password inside DATABASE_URL in sync) ---
POSTGRES_USER=sehati
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sehati
DATABASE_URL=postgresql+asyncpg://sehati:change-me@db:5432/sehati

# --- Redis (also drives the `redis` service's --requirepass) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=change-me

# --- SMTP (required to boot — use Mailtrap/Mailhog or any test SMTP for local testing) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASSWORD=changeme
SMTP_SENDER=noreply@example.com
SMTP_IS_SSL=false

# --- Media ---
MEDIA_ROOT=/var/sehati-media
MEDIA_URL=/media
MAX_AVATAR_MB=2

# --- Firebase Cloud Messaging ---
# Service account JSON lives on the host at ./account/firebase-service-account.json
# and is mounted read-only into the container at this path — see docker-compose.yml.
FIREBASE_CREDENTIALS_PATH=account/firebase-service-account.json
